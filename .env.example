# =============================================================================
# Resumatic — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- OpenRouter ---
# All LLM calls route through OpenRouter's OpenAI-compatible API.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: shown in OpenRouter usage logs and rankings
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=Resumatic

# --- Per-Agent Model Configuration ---
# Each LLM-powered agent can use a different model from OpenRouter.
# Browse all available models at: https://openrouter.ai/models
#
# Recommended pairings:
#   Fast & free  → meta-llama/llama-3.1-8b-instruct:free
#   Balanced     → openai/gpt-4o-mini
#   High quality → anthropic/claude-3.5-sonnet
#   Cheap writer → anthropic/claude-3.5-haiku
#   Open source  → google/gemma-3-27b-it
#   Coding focus → deepseek/deepseek-chat-v3-0324:free

# Agent 1 — Orchestrator
# Role: Validates inputs, routes pipeline steps, logs status messages.
# A fast, cheap model is ideal — it only writes short status sentences.
ORCHESTRATOR_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Agent 3 — Enhancer
# Role: Rewrites and tailors resume content using the job description.
# This is the most important LLM call — use a high-quality writing model.
ENHANCER_MODEL=anthropic/claude-3.5-haiku

# --- Server ---
HOST=0.0.0.0
PORT=8000
